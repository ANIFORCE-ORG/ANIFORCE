# OpenAI Agent Service configuration

# JWT must match backend JWT_SECRET
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# OpenAI-compatible API
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://your-openai-compatible-endpoint.example.com/v1
OPENAI_AGENTS_MODEL=gpt-4o-mini
OPENAI_AGENTS_API=responses

# Backend used by MCP tools
BACKEND_BASE_URL=http://localhost:8010

# Runtime paths
AGENT_TASK_DB=runtime/agent/tasks.db
AGENT_SESSION_DB=runtime/agent/sessions.db
RUNTIME_DIR=runtime/sessions
SKILLS_DIR=runtime/skills
SANDBOX_DIR=runtime/agent/sandbox
AGENT_TRACING_ENABLED=true
