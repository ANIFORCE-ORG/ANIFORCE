# Agent 服务配置
DEBUG=False
LOG_LEVEL=INFO

# 服务端口
HOST=0.0.0.0
PORT=8020

# JWT 配置（与后端服务共享）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

# 内部服务通信 Token
INTERNAL_TOKEN=change-me-in-production

# 后端服务地址
BACKEND_URL=http://localhost:8010

# Claude API
ANTHROPIC_API_KEY=your-api-key-here

# 数据库路径
TASK_DB_PATH=runtime/agent/tasks.db
SESSION_DB_PATH=runtime/agent/sessions.db

# Runtime 配置
RUNTIME_DIR=runtime/sessions
SKILLS_SOURCE_DIR=app/skills

# CORS（开发环境）
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3010
