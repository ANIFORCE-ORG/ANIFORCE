# OpenAI Agent Service configuration

# Production logs: use JSON on stdout and let the runtime platform collect them.
# run_server.sh local overrides these values with role-specific JSON files.
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_OUTPUT=console
LOG_FILE=
LOG_SERVICE=agent-service
LOG_ROLE=api
APP_ENV=local

# JWT must match backend JWT_SECRET
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Baseline provider: Aipaibox OpenAI Responses API
OPENAI_API_KEY=your_aipaibox_api_key
OPENAI_BASE_URL=https://api.tokenlab.sh/v1
OPENAI_AGENTS_MODEL=deepseek-v4-pro
OPENAI_AGENTS_API=chat_completions

# Backend used by MCP tools
BACKEND_BASE_URL=http://localhost:8010

# Runtime paths
AGENT_TASK_DB=runtime/agent/tasks.db
AGENT_SESSION_DB=runtime/agent/sessions.db
RUNTIME_DIR=runtime/sessions
SKILLS_DIR=runtime/skills
SANDBOX_DIR=runtime/agent/sandbox

# Agents SDK runtime database（调试 SQLite，多实例/生产换 PostgreSQL）
AGENT_RUNTIME_DB_URL=sqlite+aiosqlite:///data/agent.db
AGENT_TRACING_ENABLED=true
AGENT_TRACING_PROVIDER=phoenix
AGENT_TRACE_INCLUDE_SENSITIVE_DATA=true
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=aniforce
