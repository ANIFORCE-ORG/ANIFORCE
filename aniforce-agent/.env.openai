# OpenAI Agent Service 配置

# JWT（必须和 backend 一致）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# OpenAI SDK
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=your_openai_base_url
OPENAI_AGENTS_MODEL=deepseek-v4-pro
OPENAI_AGENTS_API=chat_completions

# Backend（MCP 工具调用）
BACKEND_BASE_URL=http://localhost:18010

# Runtime
AGENT_TASK_DB=runtime/agent/tasks.db
AGENT_SESSION_DB=runtime/agent/sessions.db
RUNTIME_DIR=runtime/sessions
SKILLS_DIR=runtime/skills
SANDBOX_DIR=runtime/agent/sandbox
AGENT_TRACING_ENABLED=true
