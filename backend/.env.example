# 后端环境变量示例 — 复制为 .env 后修改
DEMO_MODE=true
DEBUG=true
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 数据库（Demo 模式下可不配置）
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/animagus
# MONGODB_URL=mongodb://localhost:27017
# Redis 仅承载短期 Agent 流事件；业务结果仍由数据库持久化
REDIS_URL=redis://127.0.0.1:6379/0
# AGENT_EVENT_STREAM_TTL_SECONDS=900
# AGENT_EVENT_STREAM_MAX_LENGTH=5000

# Meta OAuth 配置
# 从 Meta 开发者平台获取: https://developers.facebook.com/apps/
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Meta OAuth 权限范围，多个权限用逗号分隔
META_SCOPES=ads_management,ads_read,business_management,pages_show_list,pages_read_engagement

# Google OAuth 配置
# 从 Google Cloud Console 获取: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Google Ads API Developer Token
# 从 Google Ads API Center 获取: https://ads.google.com/aw/apicenter
GOOGLE_DEVELOPER_TOKEN=your_google_developer_token
# Google OAuth 权限范围，多个权限用逗号分隔
GOOGLE_SCOPES=https://www.googleapis.com/auth/adwords,profile,email,openid

# OPENAI_API_KEY=your_openai_api_key

# 服务地址配置 - Local 模式
# Local 模式使用 localhost，Cloud 模式使用实际 IP/域名
FRONTEND_BASE_URL=http://localhost:3010
BACKEND_BASE_URL=http://localhost:8010

# OAuth 回调地址配置
# 用于第三方平台（Meta/Google）OAuth 重定向
# 生产环境使用 HTTPS 域名，本地开发使用 localhost
OAUTH_REDIRECT_BASE_URL=https://www.aniforce.cc
# 本地测试时使用: OAUTH_REDIRECT_BASE_URL=http://localhost:8010

# 日志配置：本地 standalone 可用 text/console；run_server.sh local 会覆盖为 JSON 文件。
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_OUTPUT=console
LOG_FILE=
LOG_SERVICE=backend
LOG_ROLE=api
APP_ENV=local

# Agent Service（后端代理 /api/v1/agent/* 时使用）
AGENT_SERVICE_URL=http://localhost:8020

# Aliyun OSS
OSS_ACCESS_KEY_ID=your_aliyun_access_key_id
OSS_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
OSS_REGION=ap-southeast-1
OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com
OSS_BUCKET=aniforce-creative