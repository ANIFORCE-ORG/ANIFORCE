# 后端环境变量示例 — 复制为 .env 后修改
DEMO_MODE=false
DEBUG=true
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 数据库（Demo 模式下可不配置）
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/animagus
# MONGODB_URL=mongodb://localhost:27017
# REDIS_URL=redis://localhost:6379

# Meta Business / Marketing API
# 需要在 Meta App 后台把 Valid OAuth Redirect URIs 配置为 META_OAUTH_REDIRECT_URI
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://127.0.0.1:8010/api/v1/platform/meta/oauth/callback
FRONTEND_BASE_URL=http://localhost:3010
