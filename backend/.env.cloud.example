# 后端环境变量示例 — Cloud 模式配置
DEMO_MODE=false
DEBUG=false
LOG_LEVEL=INFO
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 数据库（生产环境配置）
