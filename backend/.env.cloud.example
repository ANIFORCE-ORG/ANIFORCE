# 后端环境变量示例 — Cloud 模式配置
DEMO_MODE=false
DEBUG=false
LOG_LEVEL=INFO
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 数据库（生产环境配置）
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/animagus
# MONGODB_URL=mongodb://localhost:27017
# REDIS_URL=redis://localhost:6379

# 外部服务
# OPENAI_API_KEY=your_openai_api_key

# 服务地址配置 - Cloud 模式
# HTTPS 生产环境使用域名
FRONTEND_BASE_URL=https://www.aniforce.cc
BACKEND_BASE_URL=https://www.aniforce.cc

# OAuth 回调地址配置
# 用于第三方平台（Meta/Google）OAuth 重定向
OAUTH_REDIRECT_BASE_URL=https://www.aniforce.cc

# 日志配置
LOG_LEVEL=INFO
