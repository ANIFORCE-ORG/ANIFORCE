# Demo mode: enable mock API responses in the frontend.
VITE_DEMO_MODE=true

# Vite dev server settings.
VITE_FRONTEND_PORT=3010
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=8010

# Backend API used by the frontend, including the Agent gateway.
VITE_API_BASE_URL=http://localhost:8010/api/v1

# Frontend runtime URLs.
VITE_WS_URL=/ws
VITE_REACT_APP_URL=http://localhost:3001
VITE_VUE_APP_URL=http://localhost:3002
